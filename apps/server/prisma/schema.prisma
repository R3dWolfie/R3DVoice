generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String
  passwordHash String
  createdAt    DateTime @default(now())

  // Null until the user clicks the verification link. Backfilled to createdAt
  // for pre-existing accounts so nobody is retroactively locked out. Only
  // gates the client when email is configured (SMTP_HOST set).
  emailVerifiedAt DateTime?

  totpSecret    String?
  totpEnabledAt DateTime?
  // Highest 30s TOTP step counter already consumed at login. A code whose step
  // is <= this is a replay and is rejected (one-time semantics like backup
  // codes). Null until the first successful TOTP login.
  lastTotpStep  Int?

  // Base64-encoded X25519 public key for E2EE DMs. Generated client-side at
  // register; the matching private key never reaches the server. Optional
  // because legacy accounts created before E2EE shipped won't have one.
  e2eePublicKey String?

  // Hybrid E2EE key escrow: the user's secret key encrypted with a key derived
  // from their PASSWORD (client-side PBKDF2). The server stores only this
  // opaque blob — it can't decrypt it without the password. Lets the same key
  // reach every device the user logs into, so DMs are readable everywhere
  // without a manual key-file restore.
  e2eeWrappedKey String?
  e2eeKeySalt    String?
  e2eeKeyNonce   String?

  // handle is the user-displayed form (preserves casing chosen at signup).
  // handleLower is the canonical case-insensitive form used for uniqueness
  // and lookups so @Red and @red collide as the same identity.
  handle      String?
  handleLower String?  @unique
  dndUntil    DateTime?
  // Last moment this user had at least one live WebSocket, stamped when their
  // final socket closes (they go fully offline). Powers the friends list
  // "last seen 2h ago" label. Null until the first disconnect.
  lastSeenAt  DateTime?
  avatarUrl   String?
  currentRoomId   String?
  currentRoom     Room?    @relation("UserCurrentRoom", fields: [currentRoomId], references: [id], onDelete: SetNull)

  sessions      Session[]
  ownedRooms    Room[]           @relation("RoomOwner")
  memberships   RoomMembership[]
  messages      Message[]
  friendshipsRequested  Friendship[] @relation("FriendshipRequester")
  friendshipsReceived   Friendship[] @relation("FriendshipRecipient")
  invites       Invite[]
  reactions     Reaction[]
  backupCodes   TotpBackupCode[]
  emailTokens   EmailToken[]
  threadReads     ThreadReadState[]
  threadMutes     ThreadMuteState[]
  directInvitesSent     DirectInvite[] @relation("DirectInviteFrom")
  directInvitesReceived DirectInvite[] @relation("DirectInviteTo")

  // 4.15 bell "Mark all read" watermark — mention rows older than this are
  // counted as seen. Null = never marked (everything is fresh).
  notificationsSeenAt DateTime?
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Room {
  id          String  @id @default(uuid())
  name        String
  /** Free-text blurb shown in room settings and the public directory (4.9/4.7). */
  description String?
  ownerId     String
  // When true, anyone with the room ID/link can join — token mint skips the
  // membership check. When false (default for new rooms), only the owner +
  // explicitly-invited members get a LiveKit token. Existing rooms get
  // isPublic=true via migration backfill to preserve historical behavior.
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  owner       User             @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships RoomMembership[]
  invites     Invite[]
  directInvites   DirectInvite[]
  presentUsers    User[]   @relation("UserCurrentRoom")

  @@index([ownerId])
}

model RoomMembership {
  userId     String
  roomId     String
  lastJoined DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@index([roomId])
}

// Polymorphic chat message — backs both per-room chat and 1:1 DMs.
//
// threadType is "room" or "dm".
//   room: threadId = roomId (FK semantics enforced in handler, not at DB level
//         since the Room → Message relation is loose: Messages outlive Rooms
//         being deleted only by cascade through application logic, not Prisma).
//   dm:   threadId = canonical pair "<smaller-uuid>:<larger-uuid>" so both
//         participants resolve the same thread.
model Message {
  id         String   @id @default(uuid())
  threadType String   // "room" | "dm"
  threadId   String
  authorId   String
  body       String
  mentions   String?
  /** JSON array of {url,name,mime,size} — message file attachments (#30). */
  attachments String?
  /** JSON {question,options:[{id,text}],votes:{userId:optionId}} — poll (#29). */
  poll       String?
  createdAt  DateTime @default(now())
  editedAt   DateTime?
  deletedAt  DateTime?
  /** 2.5p pins — set by any thread participant, cleared on unpin. */
  pinnedAt   DateTime?
  pinnedById String?

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions Reaction[]

  @@index([threadType, threadId, createdAt])
  @@index([threadType, threadId, pinnedAt])
  @@index([authorId])
}

// Friendship between two users. Stored directionally — `requesterId` sent the
// request, `recipientId` received it. status transitions:
//   pending  → accepted (recipient accepts)
//   pending  → rejected (recipient rejects; row is deleted by handler)
//   accepted → blocked  (either side blocks)
// Uniqueness enforced at the canonical-pair level via the @@unique constraint.
// One-time 2FA backup codes (3.3b). Only hashes at rest; usedAt marks burn.
model TotpBackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Friendship {
  id           String   @id @default(uuid())
  requesterId  String
  recipientId  String
  status       String   // "pending" | "accepted" | "blocked"
  requestedAt  DateTime @default(now())
  respondedAt  DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("FriendshipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
}

model Invite {
  id           String    @id @default(uuid())
  code         String    @unique
  kind         String    // 'room' | 'friend' — enforced in app layer (zod)
  creatorId    String
  creator      User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  targetRoomId String?
  targetRoom   Room?     @relation(fields: [targetRoomId], references: [id], onDelete: Cascade)
  expiresAt    DateTime?
  maxUses      Int?
  uses         Int       @default(0)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([code])
  @@index([creatorId])
}

model ThreadReadState {
  userId      String
  threadType  String
  threadId    String
  lastReadAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, threadType, threadId])
  @@index([userId])
}

model ThreadMuteState {
  userId      String
  threadType  String
  threadId    String
  level       String
  mutedUntil  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, threadType, threadId])
  @@index([userId])
}

// Directed room invite (4.15 bell / 4.16 invite-friends): one specific user
// invites another specific user to a room. Distinct from Invite (shareable
// codes) — these are person-to-person, expire in 24h, and feed the bell's
// Invites tab. At most one *pending* row per (room, target) — enforced in the
// handler by deleting prior pending rows before create.
model DirectInvite {
  id          String    @id @default(uuid())
  roomId      String
  fromUserId  String
  toUserId    String
  status      String    @default("pending") // "pending" | "accepted" | "declined"
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  from User @relation("DirectInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User @relation("DirectInviteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status, createdAt])
  @@index([roomId, status])
}

// Single-use email tokens for verify-address and password-reset flows. Only
// the sha256 hash of the raw token is stored; the raw value lives only in the
// emailed link. kind = "verify" | "reset".
model EmailToken {
  id        String    @id @default(uuid())
  userId    String
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}
